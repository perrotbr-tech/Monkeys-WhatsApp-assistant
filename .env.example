# Copy to .env and fill in for live WhatsApp Cloud API usage.
# When these are unset, the server runs in dev mode and logs outgoing
# messages instead of calling the Meta Graph API, so it is fully runnable
# and testable without real credentials.

PORT=3000

# Token you choose; Meta calls your webhook with it during verification.
WHATSAPP_VERIFY_TOKEN=dev-verify-token

# Permanent/temporary access token from the Meta app dashboard.
WHATSAPP_ACCESS_TOKEN=

# Phone number ID from the WhatsApp > API Setup page.
WHATSAPP_PHONE_NUMBER_ID=

# Graph API version.
WHATSAPP_API_VERSION=v21.0
