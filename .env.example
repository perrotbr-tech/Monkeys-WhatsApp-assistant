PORT=3000

# Intent provider. Only "demo" is enabled in this MVP (local NLU, no API keys).
# "llm" is reserved for a future provider and will refuse to run.
AI_PROVIDER=demo

# WhatsApp is a future channel. Leave these empty to stay in dev mode
# (inbound webhooks are processed; outbound replies are logged, not sent).
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
